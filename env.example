# Copy this file to ".env" and fill in your own values. Never commit ".env".

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=put_your_mysql_password_here
MYSQL_DATABASE=smartcloud

# Use three different long random values
ADMIN_TOKEN=change_me_admin_token
WORKER_SHARED_TOKEN=change_me_worker_token
CLIENT_TOKENS_JSON={"pc2":"change_me_client_token"}

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
MAX_REQUEST_BYTES=65536
MAX_TASK_INPUT_BYTES=32768
MAX_QUEUED_JOBS=10
HEARTBEAT_TIMEOUT_SECONDS=45
MYSQL_CONNECT_TIMEOUT_SECONDS=5
